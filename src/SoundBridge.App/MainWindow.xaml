<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:core="clr-namespace:SoundBridge.Core;assembly=SoundBridge.Core"
        x:Class="SoundBridge.App.MainWindow"
        Title="声桥"
        Width="328"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Foreground="#172D43"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True">
    <Window.Resources>
        <SolidColorBrush x:Key="Accent" Color="#185E91" />
        <SolidColorBrush x:Key="Muted" Color="#51677F" />
        <Style x:Key="QuietButton" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource Accent}" />
            <Setter Property="Background" Value="#E1F2FE" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface"
                                CornerRadius="7"
                                BorderThickness="1"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="#CEE9FC" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="#B7DDF8" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Surface" Property="BorderBrush" Value="{StaticResource Accent}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Surface" Property="Opacity" Value="0.55" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="#F8FCFF" BorderBrush="#CCDDED" BorderThickness="1"
            CornerRadius="14" Padding="12">
        <StackPanel>
            <Grid Margin="3,1,3,9">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="声桥" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button x:Name="RefreshButton" Style="{StaticResource QuietButton}"
                            Background="Transparent" Content="刷新" Click="OnRefreshClick" />
                    <Button x:Name="CloseDeviceWindowButton" Style="{StaticResource QuietButton}"
                            Background="Transparent" Content="关闭" Margin="4,0,0,0"
                            Visibility="Collapsed" Click="OnCloseDeviceWindowClick" />
                </StackPanel>
            </Grid>

            <TextBlock x:Name="ScanNotice" Margin="10,6,10,10" FontSize="12"
                       Foreground="{StaticResource Muted}" TextWrapping="Wrap" Visibility="Collapsed" />

            <ScrollViewer MaxHeight="320" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding Devices}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border x:Name="DeviceSurface" Background="#EDF4FA"
                                    CornerRadius="9" Padding="10,9" Margin="0,0,0,4">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center" Margin="0,0,10,0">
                                        <TextBlock Text="{Binding Name}" ToolTip="{Binding Name}"
                                                   FontWeight="SemiBold" FontSize="13"
                                                   TextTrimming="CharacterEllipsis" />
                                        <DockPanel Margin="0,3,0,0">
                                            <Ellipse x:Name="StateDot" Fill="#778CA2" Width="6" Height="6"
                                                     Margin="0,4,5,0" VerticalAlignment="Top" />
                                            <TextBlock x:Name="DeviceStateText" Text="{Binding StateText}"
                                                       Foreground="{StaticResource Muted}" FontSize="11"
                                                       TextWrapping="Wrap" />
                                        </DockPanel>
                                    </StackPanel>
                                    <Button x:Name="DeviceAction" Grid.Column="1" MinWidth="58"
                                            Style="{StaticResource QuietButton}" Content="{Binding ActionText}"
                                            IsEnabled="{Binding CanToggle}"
                                            VerticalAlignment="Center" Click="OnToggleClick" Tag="{Binding}" />
                                </Grid>
                            </Border>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding State}" Value="{x:Static core:ConnectionState.Connected}">
                                    <Setter TargetName="DeviceSurface" Property="Background" Value="#E4F3FE" />
                                    <Setter TargetName="StateDot" Property="Fill" Value="#2882C0" />
                                    <Setter TargetName="DeviceStateText" Property="Foreground" Value="{StaticResource Accent}" />
                                    <Setter TargetName="DeviceAction" Property="Background" Value="Transparent" />
                                    <Setter TargetName="DeviceAction" Property="BorderBrush" Value="#ABCFEB" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding State}" Value="{x:Static core:ConnectionState.Failed}">
                                    <Setter TargetName="StateDot" Property="Fill" Value="#A53C33" />
                                    <Setter TargetName="DeviceStateText" Property="Foreground" Value="#93342B" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </StackPanel>
    </Border>
</Window>
